# Required. Generate a random secret with: openssl rand -base64 48
JWT_SECRET=

# Local SQLite file. In production, place this on a persistent encrypted volume.
DATABASE_PATH=./data/licenses.sqlite
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=https://licenses.example.com

# Mercado Pago credentials are server-only. Never put these in the desktop app.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_MONTHLY_PRICE_BRL=15.00
MP_ANNUAL_PRICE_BRL=150.00

# Apple Server Notifications V2. Set only after creating an App Store Connect app.
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_ENVIRONMENT=Production
APPLE_MONTHLY_PRODUCT_IDS=
APPLE_ANNUAL_PRODUCT_IDS=
# Comma-separated filesystem paths to Apple's official Root CA certificates (DER or PEM).
APPLE_ROOT_CERT_PATHS=
